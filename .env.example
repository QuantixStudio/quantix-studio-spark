# Quantix Studio environment template
#
# Usage:
# 1. Copy this file to .env
# 2. Replace the placeholder values below
# 3. Restart the dev server after updating env vars
#
# Supabase dashboard:
# https://supabase.com/dashboard/project/<your-project-ref>/settings/api

# Project Reference
VITE_SUPABASE_PROJECT_ID=your_project_ref

# Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Local dev server
#
# Canonical local URL: http://127.0.0.1:3000/
VITE_PORT=3000

# Google Analytics
#
# Production GA4 stream. Localhost analytics is disabled by default to avoid
# polluting live reports; set VITE_ENABLE_ANALYTICS_IN_DEV=true only for GA DebugView.
VITE_GA_MEASUREMENT_ID=G-BM1YFPM5ZB
VITE_ENABLE_ANALYTICS_IN_DEV=false
