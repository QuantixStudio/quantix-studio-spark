# Supabase Configuration
# Get these values from:
# https://supabase.com/dashboard/project/<your-new-project-ref>/settings/api

VITE_SUPABASE_PROJECT_ID=your_new_project_ref
VITE_SUPABASE_PUBLISHABLE_KEY=your_new_anon_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co

# Instructions:
# 1. Copy this file to .env
# 2. Replace placeholder values with real credentials from Supabase dashboard
# 3. Never commit .env to version control (already in .gitignore)
